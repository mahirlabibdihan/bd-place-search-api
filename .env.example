NODE_ENV=development
PORT=5000
PHOTON_BASE_URL=http://127.0.0.1:2322
PHOTON_REQUEST_TIMEOUT_MS=2000
PHOTON_RESULT_LIMIT=5
PLACE_SEARCH_MIN_CHARS=2
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=1000
SEARCH_INDEX_ADMIN_TOKEN=replace-with-a-long-random-token
SEARCH_INDEX_UPDATE_ENABLED=true
SEARCH_INDEX_UPDATE_TIMEOUT_SECONDS=7200
NOMINATIM_PROJECT_DIR=/srv/nominatim/project
NOMINATIM_BIN=/srv/nominatim/venv/bin/nominatim
NOMINATIM_DATABASE=nominatim
PSQL_BIN=/usr/bin/psql
NOMINATIM_STATUS_DSN=postgresql://place_search_status@127.0.0.1:5432/nominatim
NOMINATIM_STATUS_PGPASSFILE=/srv/place-search/.pgpass
GEOFABRIK_REPLICATION_STATE_URL=https://download.geofabrik.de/asia/bangladesh-updates/state.txt
PHOTON_UPDATE_URL=http://127.0.0.1:2322/nominatim-update
PHOTON_UPDATE_STATUS_URL=http://127.0.0.1:2322/nominatim-update/status
