FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl sudo supervisor openssl postgresql \
      postgresql-postgis postgresql-postgis-scripts osm2pgsql build-essential \
      pkg-config libicu-dev python3-venv python3-pip python3-dev \
      openjdk-21-jre-headless wget jq bzip2 redis-server \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --home-dir /srv/nominatim --shell /bin/bash nominatim \
 && useradd --system --create-home --home-dir /srv/photon --shell /usr/sbin/nologin photon

WORKDIR /app

# Build the complete searchable snapshot into the image. The setup script removes
# the downloaded PBF and caches after the database and Photon index are ready.
COPY .env.example /app/.env.example
COPY scripts/setup-search-engine.sh /app/scripts/setup-search-engine.sh
RUN chmod +x /app/scripts/setup-search-engine.sh \
 && cp /app/.env.example /app/.env.build \
 && sed -i \
      -e 's|^SEARCH_INDEX_ADMIN_TOKEN=.*|SEARCH_INDEX_ADMIN_TOKEN=build-only|' \
      -e 's|^DB_PASS=.*|DB_PASS=render-status-internal|' \
      -e 's|^NOMINATIM_DB_PASS=.*|NOMINATIM_DB_PASS=render-nominatim-internal|' \
      -e 's|^PHOTON_DB_PASS=.*|PHOTON_DB_PASS=render-photon-internal|' \
      /app/.env.build \
 && service postgresql start \
 && bash /app/scripts/setup-search-engine.sh /app/.env.build \
 && service postgresql stop \
 && rm -f /app/.env.build \
 && rm -rf /root/.cache /tmp/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY . .
RUN chmod +x docker/render-entrypoint.sh scripts/*.sh \
 && mkdir -p /var/log/place-search

EXPOSE 10000
ENTRYPOINT ["/app/docker/render-entrypoint.sh"]
